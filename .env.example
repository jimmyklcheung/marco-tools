# ── Weekly Signal Screen — Email Credentials ─────────────────────────────────
#
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# IMPORTANT: .env is in .gitignore — never commit your real credentials.
#
# Gmail setup steps:
#   1. Enable 2-Step Verification on your Gmail account
#      → myaccount.google.com/security
#   2. Generate a Gmail App Password (16 characters):
#      → myaccount.google.com/apppasswords
#      (App = "Mail", Device = "Other" → name it "signal-screen")
#   3. Copy the 16-char code below (spaces are fine — Gmail accepts them)

# Gmail address used as the sender
REPORT_EMAIL_USER=your.gmail@gmail.com

# Gmail App Password (16-char code from myaccount.google.com/apppasswords)
REPORT_EMAIL_PASS=xxxx xxxx xxxx xxxx

# Recipient (default already set to jimmy.klcheung@gmail.com in screener.py)
# Uncomment to override:
# REPORT_TO=jimmy.klcheung@gmail.com
